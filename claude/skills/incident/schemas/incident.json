{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incident Summary",
  "description": "Schema for stakeholder-friendly incident summaries",
  "type": "object",
  "required": ["title", "date", "severity", "status", "what_happened", "impact", "timeline"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Brief incident title (e.g., 'Checkout Unavailable')"
    },
    "incident_id": {
      "type": "string",
      "description": "Incident ID (e.g., INC-123) or empty string if not assigned"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Incident date in YYYY-MM-DD format"
    },
    "severity": {
      "type": "string",
      "enum": ["Critical", "Major", "Minor"],
      "description": "Incident severity level"
    },
    "duration": {
      "type": "string",
      "description": "Duration of incident (e.g., '2h 15m') or empty if ongoing"
    },
    "status": {
      "type": "string",
      "enum": ["Resolved", "Monitoring", "Investigating"],
      "description": "Current incident status"
    },
    "what_happened": {
      "type": "string",
      "description": "Plain language summary for non-technical stakeholders. Focus on user experience, not technical details."
    },
    "impact": {
      "type": "object",
      "required": ["users_affected", "duration", "features_impacted"],
      "properties": {
        "users_affected": {
          "type": "string",
          "description": "Number or percentage of affected users"
        },
        "duration": {
          "type": "string",
          "description": "How long users were impacted"
        },
        "features_impacted": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of affected features/functionality"
        },
        "business_impact": {
          "type": "string",
          "description": "Business impact (e.g., GMV loss) or 'Assessing' if unknown"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["iOS", "Android", "Web", "All"]
          },
          "description": "Affected platforms"
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time", "event"],
        "properties": {
          "time": {
            "type": "string",
            "description": "Time in HH:MM format with timezone"
          },
          "event": {
            "type": "string",
            "description": "Description of what happened at this time"
          }
        }
      }
    },
    "timezone": {
      "type": "string",
      "default": "UTC",
      "description": "Timezone for all times in the timeline"
    },
    "root_cause": {
      "type": "string",
      "description": "Plain language explanation of root cause, or '[Under investigation]' if not yet determined"
    },
    "resolution": {
      "type": "string",
      "description": "What fixed the issue (rollback, config change, hotfix) or '[Pending]' if not resolved"
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Action items for follow-up"
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Links to incident.io, Datadog, etc."
    }
  }
}
